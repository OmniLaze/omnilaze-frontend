    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "~19.0.10",
    "@types/react-dom": "^19.1.7",
    "playwright": "^1.55.0",
    "typescript": "~5.8.3"
