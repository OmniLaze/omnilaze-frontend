    "test:mobile": "node tests/test-mobile.js",
    "test:mobile:iphone": "node tests/test-mobile.js 'iPhone 14 Pro'",
    "test:mobile:android": "node tests/test-mobile.js 'Samsung Galaxy S21'",
    "test:mobile:all": "node tests/test-mobile.js --all",
    "test:db:check": "node tests/check-db.js",
    "test:db:seed": "node tests/create-order.js",
    "test:order-sync": "node tests/test-order-sync.js",
    "test:order-sync:headless": "HEADLESS=true node tests/test-order-sync.js"
