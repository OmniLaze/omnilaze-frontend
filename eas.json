{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
      "env": {
        "REACT_APP_API_URL": "https://backend.omnilaze.co"
      }
    },
    "production": {
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
      "env": {
        "REACT_APP_API_URL": "https://backend.omnilaze.co"
      }
    }
  },
  "submit": {
    "production": {}
  }
}